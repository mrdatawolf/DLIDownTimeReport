# Relative paths resolve from this project directory. Absolute paths also work.
REPORTS_DIR=Samples
DB_PATH=data/downtime.sqlite3
# Use 127.0.0.1 for local access, 0.0.0.0 for all interfaces,
# or an actual IPv4 address assigned to this server (for example 192.168.1.50).
HOST=127.0.0.1
PORT=8087
SCAN_INTERVAL_SECONDS=30
# Wait for copied files to stop changing before processing.
FILE_SETTLE_SECONDS=10
